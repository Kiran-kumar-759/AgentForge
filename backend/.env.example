APP_NAME=ORCA
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/orca

REDIS_URL=redis://localhost:6379/0

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LLM providers
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# LLM routing
PRIMARY_LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER_1=gemini
FALLBACK_LLM_PROVIDER_2=openrouter

GROQ_MODEL=llama3-70b-8192
GEMINI_MODEL=gemini-1.5-pro
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Future scientific/data providers
EARTHDATA_TOKEN=

MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# Application configuration
BACKEND_CORS_ORIGINS=http://localhost:5173

# Phase 2 Providers
OPEN_METEO_BASE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_CACHE_TTL_SECONDS=900

NOAA_ERDDAP_BASE_URL=https://coastwatch.pfeg.noaa.gov/erddap
NOAA_ERDDAP_DATASET_ID=jplMURSST41
NOAA_CACHE_TTL_SECONDS=3600

EARTHDATA_CMR_BASE_URL=https://cmr.earthdata.nasa.gov/search
NASA_DATASET_ID=
NASA_CACHE_TTL_SECONDS=21600

MOSDAC_DATASET_ID=
MOSDAC_CACHE_TTL_SECONDS=21600

DATA_REQUEST_TIMEOUT_SECONDS=30
DATA_MAX_QUERY_HOURS=720
DATA_MAX_RECORDS_PER_REQUEST=10000
